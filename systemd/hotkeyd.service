# managed by localSTT v1 — install.sh fills in your user name and writes this to /etc/systemd/system/
#
# The only process on the machine that reads the keyboard for dictation. It runs as its own
# system user in group `input`, so your login session never needs that group. Everything below
# the [Service] line locks it down to: read /dev/input, write one socket under /run/hotkeyd.
# Check with: systemd-analyze security hotkeyd   (target: under 3)
[Unit]
Description=localSTT hotkey daemon (F13 hold -> start/stop on a socket)
Documentation=file:///usr/local/lib/hotkeyd/hotkeyd.py

[Service]
ExecStart=/usr/bin/python3 -u /usr/local/lib/hotkeyd/hotkeyd.py
User=hotkeyd
Group=hotkeyd
SupplementaryGroups=input
Restart=always
RestartSec=1
Environment=PYTHONDONTWRITEBYTECODE=1

# /run/hotkeyd: owned by hotkeyd, group @USER@, setgid so the socket inherits that group
# and comes out 0660 (hotkeyd rw, you rw, nobody else). The `+` runs this one line as root.
RuntimeDirectory=hotkeyd
RuntimeDirectoryMode=0750
ExecStartPre=+/bin/sh -c 'chgrp @USER@ /run/hotkeyd && chmod 2750 /run/hotkeyd'

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
DevicePolicy=closed
DeviceAllow=char-input r
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
UMask=0117

[Install]
WantedBy=multi-user.target
